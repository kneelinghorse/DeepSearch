# DeepSearch Production Configuration
# Copy to .env and fill in values

# ============================================
# REQUIRED - TraceLab Integration
# ============================================

# TraceLab API endpoint
TRACELAB_BASE_URL=http://localhost:8000

# Preferred service-principal credential. The resolved principal must return
# role=service from /api/v1/auth/me.
TRACELAB_API_KEY=your_tracelab_service_api_key

# Shared HMAC secret for post-commit completion receipts. Configure the exact
# same value on TraceLab's DeepSearch webhook receiver.
TRACELAB_DEEPSEARCH_SERVICE_SECRET=your_shared_receipt_secret

# Explicit JWT fallback when no API key is configured. These credentials must
# also resolve to a service principal, not a human account.
TRACELAB_USERNAME=your_tracelab_username
TRACELAB_PASSWORD=your_tracelab_password

# ============================================
# REQUIRED - Production Web Search
# CodeAgent retrieval uses Linkup; configure this key for research runs.
LINKUP_API_KEY=your_linkup_key
# Optional retrieval fallback
EXA_API_KEY=your_exa_key

# Legacy development search adapters below are separate from CodeAgent retrieval.
# ============================================

# Search backend: "serp" (SerpAPI/Google, recommended), "google" (Gemini grounding), "tavily", or "exa"
# serp uses SerpAPI for literal Google search (best for source diversity)
# google uses native Gemini google_search grounding
SEARCH_BACKEND=serp

# Tavily API key (only required if SEARCH_BACKEND=tavily)
# Get from: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxx

# ============================================
# OPTIONAL - Legacy local LLM callers
# ============================================

# Ollama is not used by the production CodeAgent worker.
OLLAMA_BASE_URL=http://localhost:11434

# Default model for research
OLLAMA_MODEL=llama3.2

# ============================================
# OPTIONAL - LLM Backend Selection
# ============================================

# Production LLM backend: "deepseek" (default) or "openai", shared by every stage.
# Unknown values fail preflight; they never silently select another provider.
# Other adapters below are retained for legacy development callers only.
LLM_BACKEND=deepseek

# Wall-clock ceiling for a single LLM request, in seconds. Default: 300.
# The openai client otherwise defaults to 600s with retries, which lets an
# unresponsive endpoint hold a mission lease for tens of minutes.
# LLM_REQUEST_TIMEOUT_SECONDS=300

# --- Gemini Backend ---
# Get from: https://console.cloud.google.com
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-pro
# REFLECTION_GEMINI_MODEL=gemini-2.5-flash  # default

# --- DeepSeek Backend ---
# Get from: https://platform.deepseek.com
# DEEPSEEK_API_KEY=your_deepseek_key
# DEEPSEEK_MODEL=deepseek-flash                  # all active stages (default)
# REFLECTION_DEEPSEEK_MODEL is retired from the production path
# DEEPSEEK_BASE_URL=https://api.deepseek.com      # default
# Temperature is omitted by the production request contract
# DEEPSEEK_MAX_TOKENS=32768

# --- OpenAI Luna Backend ---
# Select LLM_BACKEND=openai to use this configuration for every active stage.
# OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_TOKENS=32768
# LLM_REASONING_EFFORT=medium  # OpenAI default; DeepSeek default is high
# Exact supported identities, precedence and migration: docs/model_configuration.md

# ============================================
# OPTIONAL - Semantic Matching
# ============================================

# Embedding model for semantic citation matching
# Default: nomic-embed-text
DEEPSEARCH_EMBEDDING_MODEL=nomic-embed-text

# Enable semantic citation matching (requires Ollama)
# Default: true
DEEPSEARCH_USE_SEMANTIC_MATCHING=true

# Citation similarity threshold (0.0-1.0)
# Default: 0.7
DEEPSEARCH_SIMILARITY_THRESHOLD=0.7

# ============================================
# OPTIONAL - Feature Flags
# ============================================

# Enable new span-aware citation engine (B3.2)
# Default: true
USE_NEW_CITATION_ENGINE=true

# Enable new reflection parser
# Default: true
USE_NEW_REFLECTION_PARSER=true

# ============================================
# OPTIONAL - Paths
# ============================================

# Runtime data root (default: checkpoints/ relative to the working directory)
# DEEPSEARCH_DATA_ROOT=checkpoints

# Per-kind paths override the data root; explicit function/CLI paths win.
# Checkpoint database for multi-session research
# CHECKPOINT_DB_PATH=checkpoints/deepsearch.db

# Report output directory (default: <data root>/reports)
# DEEPSEARCH_REPORT_DIR=checkpoints/reports

# Telemetry directory (default: <data root>/telemetry)
# DEEPSEARCH_TELEMETRY_DIR=checkpoints/telemetry

# Compiled contract directory (default: <data root>/contracts)
# DEEPSEARCH_CONTRACT_DIR=checkpoints/contracts

# ============================================
# OPTIONAL - Performance Tuning
# ============================================

# LLM temperature (0.0-1.0)
OLLAMA_TEMPERATURE=0.7
GEMINI_TEMPERATURE=0.7

# Max output tokens (higher = more comprehensive reports)
OLLAMA_MAX_TOKENS=2000
GEMINI_MAX_TOKENS=8000

# Thread ID prefix for LangGraph
THREAD_ID_PREFIX=deepsearch

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# OPTIONAL - Retry/Resilience Configuration
# ============================================

# Tool retry settings
TOOL_MAX_RETRIES=3
TOOL_BACKOFF_BASE=1.0
TOOL_BACKOFF_MAX=60.0
TOOL_BACKOFF_JITTER_MS=200

# Circuit breaker settings
TOOL_CIRCUIT_FAILURE_THRESHOLD=5
TOOL_CIRCUIT_SUCCESS_THRESHOLD=2
TOOL_CIRCUIT_TIMEOUT_SECONDS=60

# LLM retry settings
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_MAX=30.0
LLM_BACKOFF_JITTER_MS=150

# ============================================
# RAILWAY DEPLOYMENT (Worker Mode)
# ============================================

# PostgreSQL connection URL (provided by Railway)
# Format: postgresql://user:pass@host:port/db
# Railway sets this automatically when linking PostgreSQL service
DATABASE_URL=postgresql://user:password@host:5432/database

# Worker polling interval (seconds between DB checks)
# Default: 5.0
WORKER_POLL_INTERVAL=5.0

# Lease-loss execution fence. Startup requires the strict invariant
# H + D + U + M < L + G; defaults are 30 + 10 + (2 + 3 + 3) + 10 < 120 + 30.
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
WORKER_HEARTBEAT_TIMEOUT_SECONDS=10
WORKER_RECLAIM_GRACE_SECONDS=30
WORKER_MAX_LEASE_ATTEMPTS=3
WORKER_CANCELLATION_GRACE_SECONDS=2
WORKER_TERMINATE_GRACE_SECONDS=3
WORKER_KILL_GRACE_SECONDS=3
WORKER_LEASE_SAFETY_MARGIN_SECONDS=10

# Attempt-local contract/report/protocol/telemetry/checkpoint sandboxes.
WORKER_ATTEMPT_ROOT=checkpoints/worker-attempts

# Worker logging level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
WORKER_LOG_LEVEL=INFO

# Log format: "text" for local dev, "json" for Railway/cloud
# JSON provides structured logs for Railway's log viewer
# Default: text
WORKER_LOG_FORMAT=json

# ============================================
# RAILWAY-SPECIFIC NOTES
# ============================================
#
# When deploying to Railway:
# 1. DATABASE_URL is auto-set when you link TraceLab's PostgreSQL
# 2. Set API key for your chosen backend (OPENAI_API_KEY or DEEPSEEK_API_KEY)
# 3. WORKER_LOG_FORMAT=json recommended for structured logging
# 4. No PORT needed - worker mode (not a web service)
#
# Required Railway Variables:
#   - DATABASE_URL (auto-linked from PostgreSQL)
#   - LLM_BACKEND (openai or deepseek)
#   - OPENAI_API_KEY (if LLM_BACKEND=openai)
#   - DEEPSEEK_API_KEY (if LLM_BACKEND=deepseek)
#
# Optional Railway Variables:
#   - WORKER_POLL_INTERVAL (default: 5.0)
#   - WORKER_LOG_LEVEL (default: INFO)
#   - WORKER_LOG_FORMAT (default: text, use "json" for Railway)
#   - GEMINI_MODEL (default: gemini-2.5-pro)
#   - DEEPSEEK_MODEL (default: deepseek-flash)
#   - OPENAI_MODEL (default: gpt-5.6-luna)
